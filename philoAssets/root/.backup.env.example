# SMTP (for email alerts via exim4 smarthost)
SMTP_HOST='mail.infomaniak.com'
SMTP_USER='webmaster@example.com'
SMTP_PASS='your-smtp-password-here'
SMTP_SENDER_NAME='Philosophie.ch Server'

# Email alert recipients (space-separated)
ALERT_RECIPIENTS='info@example.com it@example.com'
