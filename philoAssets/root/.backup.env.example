# Use single quotes to prevent bash from expanding special characters

# Directory on the server to back up
ASSETS_DIR='/home/sysadmin/philosophie-ch-assets'

# Swift Backup (Infomaniak)
SB_USERNAME='sb_project_SBI-XXXXXX'
