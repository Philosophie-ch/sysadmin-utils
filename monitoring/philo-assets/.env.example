# Ports for the monitoring exporters (localhost only)
CADVISOR_PORT=8089
NODE_EXPORTER_PORT=9109

# Logs (Alloy)
# Value of the "server" label on this server's logs (match the Prometheus "server" label)
SERVER_LABEL=my-assets-server
# Host directory holding the reverse proxy's *_access.log and *_error.log files
PROXY_LOG_DIR=/path/to/proxy/logs
ALLOY_PORT=12345
# Loopback port the SSH tunnel's reverse forward opens to Loki;
# must equal ASSETS_LOKI_PUSH_PORT in the monitoring server's .env
LOKI_PUSH_PORT=3100
