# Servers (SSH aliases from ~/.ssh/config)
MONITOR_SERVER=my-main-server
ASSETS_SERVER=my-assets-server

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_STORAGE_SIZE=2GB

# cAdvisor
CADVISOR_PORT=8089

# Node Exporter
NODE_EXPORTER_PORT=9109

# Remote scraping (assets server ports forwarded via SSH tunnel)
ASSETS_NODE_EXPORTER_PORT=9109
ASSETS_CADVISOR_PORT=8089
TUNNEL_NODE_EXPORTER_PORT=9209
TUNNEL_CADVISOR_PORT=8189

# Logs (Loki + Alloy)
# Value of the "server" label on this server's logs (match the Prometheus "server" label)
SERVER_LABEL=my-main-server
# Host directory holding the portal's production.log, errors_and_warnings.log and 404.log
PORTAL_LOG_DIR=/path/to/portal/log
LOKI_PORT=3100
ALLOY_PORT=12345
# Port opened on the assets server's loopback by the tunnel's reverse forward to Loki;
# must equal LOKI_PUSH_PORT in philo-assets/.env
ASSETS_LOKI_PUSH_PORT=3100

# Grafana
GRAFANA_PORT=3009
# Only applied when Grafana creates its database; later changes go through reset-admin-password
GRAFANA_INITIAL_ADMIN_PASSWORD=changeme

# SMTP for Grafana alerting
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=alerts@example.com
SMTP_PASSWORD=changeme
# Must be SMTP_USER itself or an alias of that mailbox; most providers reject other senders
SMTP_FROM=alerts@example.com
SMTP_FROM_NAME="My Monitoring"
