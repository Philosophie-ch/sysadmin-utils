# Servers (SSH aliases from ~/.ssh/config)
MONITOR_SERVER=my-main-server
ASSETS_SERVER=my-assets-server

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_STORAGE_SIZE=2GB

# cAdvisor
CADVISOR_PORT=8089

# Node Exporter
NODE_EXPORTER_PORT=9109

# Remote scraping (assets server ports forwarded via SSH tunnel)
ASSETS_NODE_EXPORTER_PORT=9109
ASSETS_CADVISOR_PORT=8089
TUNNEL_NODE_EXPORTER_PORT=9209
TUNNEL_CADVISOR_PORT=8189

# Logs (Loki + Alloy)
# Value of the "server" label on this server's logs (match the Prometheus "server" label)
SERVER_LABEL=my-main-server
# Host directory holding the portal's production.log, errors_and_warnings.log and 404.log
PORTAL_LOG_DIR=/path/to/portal/log
LOKI_PORT=3100
ALLOY_PORT=12345
# Port opened on the assets server's loopback by the tunnel's reverse forward to Loki;
# must equal LOKI_PUSH_PORT in philo-assets/.env
ASSETS_LOKI_PUSH_PORT=3100

# Application databases (read-only Grafana datasources)
# Docker network the application containers run on; Grafana joins it
APPS_NETWORK=my-apps-network
# Container name, database and owning role of each database; the owner runs postgres/grant-reader.sh
PORTAL_DB_CONTAINER=my-portal-db
PORTAL_DB_NAME=my_portal_db
PORTAL_DB_OWNER=my_portal_owner
ALEXANDRIA_DB_CONTAINER=my-alexandria-db
ALEXANDRIA_DB_NAME=my_alexandria_db
ALEXANDRIA_DB_OWNER=my_alexandria_owner
# Passwords of the grafana_reader role in each database; letters and digits, at least 24
# (generate with: openssl rand -hex 24)
PORTAL_DB_READER_PASSWORD=changeme
ALEXANDRIA_DB_READER_PASSWORD=changeme

# Public access through Cloudflare Tunnel + Access (README "Access")
GRAFANA_PUBLIC_URL=https://grafana.example.com
# Zero Trust team domain and the Access application's AUD tag (Access > Applications > the app > Overview)
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CF_ACCESS_AUD=changeme
# Token of the tunnel (Networks > Tunnels > the tunnel > Configure)
CLOUDFLARED_TUNNEL_TOKEN=changeme

# Grafana
GRAFANA_PORT=3009
# Only applied when Grafana creates its database; later changes go through reset-admin-password
GRAFANA_INITIAL_ADMIN_PASSWORD=changeme

# SMTP for Grafana alerting
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=alerts@example.com
SMTP_PASSWORD=changeme
# Must be SMTP_USER itself or an alias of that mailbox; most providers reject other senders
SMTP_FROM=alerts@example.com
SMTP_FROM_NAME="My Monitoring"
